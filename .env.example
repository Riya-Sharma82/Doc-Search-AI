# ─────────────────────────────────────────────
# DocSearch AI — Environment Variables Example
# Copy this file to .env and fill in real values
# ─────────────────────────────────────────────

# ── LLM ──────────────────────────────────────
GEMINI_API_KEY=GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── Embedding model ───────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Alternatively use a larger model:
# EMBEDDING_MODEL=all-mpnet-base-v2

# ── Retrieval ────────────────────────────────
VECTOR_STORE_TYPE=faiss          # faiss | chroma
TOP_K_RESULTS=10
HYBRID_ALPHA=0.5                 # 0 = BM25 only, 1 = semantic only
ENABLE_RERANKER=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Chunking ──────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── File limits ───────────────────────────────
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,txt

# ── Storage paths ────────────────────────────
UPLOAD_DIR=data/uploads
VECTORSTORE_DIR=data/vectorstore

# ── Server ────────────────────────────────────
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
